{
  "options": {
    "lib": ".",
    "use": [
      "pluginmem=pluginmem"
    ],

    "exportRuntime": false,
    "runtime": "minimal",
    "debug": false,
    "optimize": true,
    "optimizeLevel": 3,
    "shrinkLevel" : 2,
    "noAssert": true
  },
  "targets": {
    "json": {
      "transform": ["json-as/transform"],
      "initialMemory": "1"
    }
  }
}
